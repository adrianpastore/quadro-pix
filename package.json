{
  "name": "quadro-pix",
  "private": true,
  "scripts": {
    "build": "npm run build:js && npm run build:css",
    "build:js": "esbuild src/app.jsx --bundle --minify --target=es2019 --define:process.env.NODE_ENV=\\\"production\\\" --outfile=dist/app.js",
    "build:css": "tailwindcss -i src/styles.css -o dist/styles.css --minify",
    "dev": "esbuild src/app.jsx --bundle --outfile=dist/app.js --watch"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "tailwindcss": "^3.4.19"
  }
}
